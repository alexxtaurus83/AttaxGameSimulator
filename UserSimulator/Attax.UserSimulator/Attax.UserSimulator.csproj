<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Attax.UserSimulator.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Attax.Agents\Attax.Agents.csproj" />
    <ProjectReference Include="..\..\Attax.Play\Attax.Play.csproj" />
    <ProjectReference Include="$(AttaxSharedRepoPath)\src\Attax.Core\Attax.Core.csproj" />
    <ProjectReference Include="$(AttaxSharedRepoPath)\src\Attax.Core.Utils\Attax.Core.Utils.csproj" />
    <ProjectReference Include="..\..\Attax.Eval.OnnxRuntime\Attax.Eval.OnnxRuntime.csproj" />
    <ProjectReference Include="$(AttaxSharedRepoPath)\src\Attax.Server.Contracts\Attax.Server.Contracts.csproj" />
    <ProjectReference Include="$(AttaxSharedRepoPath)\src\Attax.Client.Sync\Attax.Client.Sync.csproj" />
    <ProjectReference Include="$(AttaxSharedRepoPath)\src\Attax.Client.Protocol\Attax.Client.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.NewtonsoftJson" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(AttaxSharedRepoPath)\src\Attax.Core\engine-params.json" Link="engine-params.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
