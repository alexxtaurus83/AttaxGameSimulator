<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="$(AttaxSharedRepoPath)\src\Attax.Core\Attax.Core.csproj" />
    <ProjectReference Include="$(AttaxSharedRepoPath)\src\Attax.Core.Utils\Attax.Core.Utils.csproj" />
    <ProjectReference Include="..\Attax.Model\Attax.Model.csproj" />
    <ProjectReference Include="..\Attax.Data\Attax.Data.csproj" />
    <ProjectReference Include="..\Attax.Play\Attax.Play.csproj" />
    <ProjectReference Include="..\Attax.Eval.OnnxRuntime\Attax.Eval.OnnxRuntime.csproj" />
    <ProjectReference Include="$(AttaxEngineHostProjectPath)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <!-- The one source of the engine parameter values lives in AttaxShared; the console reads the copy next to the exe. -->
    <Content Include="$(AttaxSharedRepoPath)\src\Attax.Core\engine-params.json" Link="engine-params.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Attax.Core.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
