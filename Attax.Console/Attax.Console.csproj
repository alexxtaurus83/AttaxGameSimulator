<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Attax.Core\Attax.Core.csproj" />
    <ProjectReference Include="..\Attax.Core.Utils\Attax.Core.Utils.csproj" />
    <ProjectReference Include="..\Attax.Model\Attax.Model.csproj" />
    <ProjectReference Include="..\Attax.Data\Attax.Data.csproj" />
    <ProjectReference Include="..\Attax.Play\Attax.Play.csproj" />
    <ProjectReference Include="..\Attax.Eval.OnnxRuntime\Attax.Eval.OnnxRuntime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The one source of the engine parameter values lives in the Core folder; the console reads the copy next to the exe. -->
    <Content Include="..\Attax.Core\engine-params.json" Link="engine-params.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
