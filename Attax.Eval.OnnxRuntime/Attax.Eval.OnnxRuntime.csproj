<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Attax.Core\Attax.Core.csproj" />
    <ProjectReference Include="..\Attax.Core.Utils\Attax.Core.Utils.csproj" />
    <ProjectReference Include="..\Attax.Model\Attax.Model.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- CPU build only: see OnnxPolicyValueModel. The GPU package (Microsoft.ML.OnnxRuntime.Gpu) ships CUDA provider DLLs
         that were never used and made the published folder much larger. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.26.0" />
  </ItemGroup>

</Project>
